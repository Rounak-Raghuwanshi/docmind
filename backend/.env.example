# Copy to backend/.env and adjust. Every variable is documented in docs/CONFIGURATION.md.

APP_ENV=dev
LOG_LEVEL=INFO
PUBLIC_APP_URL=http://localhost:5173

# --- Data stores -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://docmind:docmind@localhost:5432/docmind
REDIS_URL=redis://localhost:6379

# --- Auth ----------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-48-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]

# --- Storage -------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage

# --- LLM (any OpenAI-compatible endpoint) ----------------------------------------
# Ollama (local, free):   http://localhost:11434/v1     key: ollama   model: llama3.2:3b
# Groq (free tier):       https://api.groq.com/openai/v1               model: llama-3.1-8b-instant
# Gemini (free tier):     https://generativelanguage.googleapis.com/v1beta/openai/   model: gemini-2.0-flash
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b
# LLM_PROVIDER=fake   # no LLM at all: canned answers, handy for UI work

# --- Retrieval models (must match between dev and prod) --------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Limits --------------------------------------------------------------------
MAX_UPLOAD_MB=20
# Set false if your pgvector is older than 0.8 (check: SELECT extversion FROM pg_extension WHERE extname='vector')
HNSW_ITERATIVE_SCAN=true
