# Copy to backend/.env and adjust. Every variable is documented in docs/CONFIGURATION.md.

APP_ENV=dev
LOG_LEVEL=INFO
PUBLIC_APP_URL=http://localhost:5173

# --- Data stores -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://docmind:docmind@localhost:5432/docmind
REDIS_URL=redis://localhost:6379

# --- Auth ----------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-48-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]

# --- Storage -------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage

# --- LLM (any OpenAI-compatible endpoint) ----------------------------------------
# none   = no AI model needed: answers quote the best-matching sentences (works out of the box)
# openai = a real model writes the answers. Pick one provider below, then set LLM_PROVIDER=openai.
LLM_PROVIDER=none
#
# Groq (free key at https://console.groq.com/keys, fastest):
#   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_API_KEY=gsk_...   LLM_MODEL=llama-3.1-8b-instant
# Ollama (offline, `ollama pull llama3.2:3b`):
#   LLM_BASE_URL=http://localhost:11434/v1        LLM_API_KEY=ollama    LLM_MODEL=llama3.2:3b
# Gemini (free key at https://aistudio.google.com/apikey):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-your-key-here
LLM_MODEL=llama-3.1-8b-instant

# --- Retrieval models (must match between dev and prod) --------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Limits --------------------------------------------------------------------
MAX_UPLOAD_MB=20
# Set false if your pgvector is older than 0.8 (check: SELECT extversion FROM pg_extension WHERE extname='vector')
HNSW_ITERATIVE_SCAN=true
